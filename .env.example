# Copie para .env e ajuste se necessário. Nunca commitar o .env real.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sistema_estagio

OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b-q8_0
EMBEDDING_DIM=1024

# Gere um valor forte antes de ir para qualquer ambiente real, ex.:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-antes-de-usar-em-producao
JWT_EXPIRE_MINUTES=60
